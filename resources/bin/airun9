#!/usr/bin/env node
/*
 * airun9 — CLI door to the AIRUN9 public local API (ADR-0008).
 * Speaks newline-delimited JSON-RPC over the app's Unix socket.
 * Injected into the PATH of every managed terminal so agents can call it.
 *
 * Usage:
 *   airun9 ping
 *   airun9 project get
 *
 *   # read-only research worker, spawns immediately
 *   airun9 worker scout --prompt "..." [--name x] [--count N]
 *
 *   # mutating worker: the USER approves mode + location in the app.
 *   # This call waits for their decision (may take a while; poll
 *   # `worker list` if your call times out — it may still be approved).
 *   airun9 worker request --prompt "..." --recommend bypass|edits|manual \
 *     [--location shared|worktree] [--reason "why this mode"] [--name x] [--count N]
 *
 *   airun9 worker list
 *   airun9 worker read <id> [--tail 20000] [--raw]     # live terminal tail
 *   airun9 worker result <id>                          # final answer (clean text)
 *   airun9 worker prompt <id> --prompt "..."           # follow-up (worker must be done)
 *   airun9 worker stop <id>
 *   airun9 terminal list|create|read
 */
'use strict'

const net = require('net')
const os = require('os')
const path = require('path')

const SOCKET_PATH = process.env.AIRUN9_SOCKET || path.join(os.homedir(), '.airun9', 'airun9.sock')

function fail(message) {
  process.stderr.write(`airun9: ${message}\n`)
  process.exit(1)
}

function parseArgs(argv) {
  const positional = []
  const flags = {}
  for (let i = 0; i < argv.length; i++) {
    const arg = argv[i]
    if (arg.startsWith('--')) {
      const key = arg.slice(2)
      const next = argv[i + 1]
      if (next === undefined || next.startsWith('--')) {
        flags[key] = true
      } else {
        flags[key] = next
        i++
      }
    } else {
      positional.push(arg)
    }
  }
  return { positional, flags }
}

function call(method, params) {
  return new Promise((resolvePromise, rejectPromise) => {
    const socket = net.createConnection(SOCKET_PATH)
    let buffer = ''
    socket.on('connect', () => {
      socket.write(JSON.stringify({ id: 1, method, params }) + '\n')
    })
    socket.on('data', (chunk) => {
      buffer += chunk.toString('utf8')
      const newline = buffer.indexOf('\n')
      if (newline === -1) return
      socket.end()
      try {
        const response = JSON.parse(buffer.slice(0, newline))
        if (response.error) rejectPromise(new Error(response.error.message))
        else resolvePromise(response.result)
      } catch (error) {
        rejectPromise(error)
      }
    })
    socket.on('error', (error) => {
      if (error.code === 'ENOENT' || error.code === 'ECONNREFUSED') {
        rejectPromise(new Error(`cannot reach AIRUN9 at ${SOCKET_PATH} — is the app running?`))
      } else {
        rejectPromise(error)
      }
    })
  })
}

function readStdin() {
  return new Promise((resolve) => {
    let data = ''
    process.stdin.on('data', (chunk) => (data += chunk))
    process.stdin.on('end', () => resolve(data))
    process.stdin.on('error', () => resolve(data))
  })
}

// Strip ANSI escape sequences so agents get readable text by default
function stripAnsi(text) {
  return text
    .replace(/\x1b\][^\x07\x1b]*(\x07|\x1b\\)?/g, '') // OSC (title set, hyperlinks)
    .replace(/\x1b\[[0-9;?]*[A-Za-z@^`~]/g, '') // CSI (colors, cursor movement)
    .replace(/\x1b[()#][0-9A-Za-z]/g, '') // charset selection
    .replace(/\x1b[A-Za-z=><]/g, '') // bare escapes
    .replace(/\r\n/g, '\n')
    .replace(/\r/g, '\n')
}

function printResult(result) {
  process.stdout.write(JSON.stringify(result, null, 2) + '\n')
}

function printRead(result, flags) {
  process.stdout.write(flags.raw ? result.data : stripAnsi(result.data))
  if (result.data && !result.data.endsWith('\n')) process.stdout.write('\n')
}

// Claude Code hook endpoint: receives the hook payload on stdin, reports the
// event for the worker identified by AIRUN9_WORKER_ID. Always exits 0 —
// a failing hook must never block the agent.
async function runHook(event) {
  try {
    const workerId = process.env.AIRUN9_WORKER_ID
    if (!workerId) return
    const payload = JSON.parse((await readStdin()) || '{}')
    await call('worker.hookEvent', {
      workerId,
      event,
      transcriptPath: payload.transcript_path || undefined
    })
  } catch {
    // swallow; observability must not break the worker
  }
}

async function main() {
  const { positional, flags } = parseArgs(process.argv.slice(2))
  const [domain, action, id] = positional
  const tail = flags.tail ? Number(flags.tail) : undefined

  if (domain === 'hook') {
    if (action !== 'stop' && action !== 'prompt-submit') fail(`unknown hook event "${action}"`)
    return runHook(action)
  }

  switch (`${domain} ${action}`) {
    case 'ping undefined':
      return printResult(await call('app.ping'))
    case 'project get':
      return printResult(await call('project.get'))
    case 'worker scout': {
      if (!flags.prompt || flags.prompt === true) fail('worker scout requires --prompt "..."')
      const params = { prompt: flags.prompt }
      if (typeof flags.name === 'string') params.name = flags.name
      if (flags.count) params.count = Number(flags.count)
      return printResult(await call('worker.scout', params))
    }
    case 'worker request': {
      if (!flags.prompt || flags.prompt === true) fail('worker request requires --prompt "..."')
      if (typeof flags.recommend !== 'string')
        fail('worker request requires --recommend bypass|edits|manual')
      const params = {
        prompt: flags.prompt,
        recommendedMode: flags.recommend,
        recommendedLocation: typeof flags.location === 'string' ? flags.location : 'shared'
      }
      if (typeof flags.name === 'string') params.name = flags.name
      if (typeof flags.reason === 'string') params.reason = flags.reason
      if (flags.count) params.count = Number(flags.count)
      process.stderr.write('airun9: waiting for the user to approve in AIRUN9…\n')
      return printResult(await call('worker.request', params))
    }
    case 'worker list':
      return printResult(await call('worker.list'))
    case 'worker get':
      if (!id) fail('usage: airun9 worker get <id>')
      return printResult(await call('worker.get', { id }))
    case 'worker read':
      if (!id) fail('usage: airun9 worker read <id>')
      return printRead(await call('worker.read', { id, tail }), flags)
    case 'worker result': {
      if (!id) fail('usage: airun9 worker result <id>')
      const result = await call('worker.result', { id })
      if (flags.json) return printResult(result)
      if (result.text === null) {
        return fail(`no result yet (worker status: ${result.status})`)
      }
      process.stdout.write(result.text + '\n')
      return
    }
    case 'worker prompt': {
      if (!id) fail('usage: airun9 worker prompt <id> --prompt "..."')
      if (!flags.prompt || flags.prompt === true) fail('worker prompt requires --prompt "..."')
      return printResult(await call('worker.prompt', { id, prompt: flags.prompt }))
    }
    case 'worker stop':
      if (!id) fail('usage: airun9 worker stop <id>')
      return printResult(await call('worker.stop', { id }))
    case 'terminal list':
      return printResult(await call('terminal.list'))
    case 'terminal create': {
      const params = {}
      if (typeof flags.cwd === 'string') params.cwd = flags.cwd
      if (typeof flags.title === 'string') params.title = flags.title
      return printResult(await call('terminal.create', params))
    }
    case 'terminal read':
      if (!id) fail('usage: airun9 terminal read <id>')
      return printRead(await call('terminal.read', { id, tail }), flags)
    default:
      fail(
        `unknown command "${positional.join(' ')}"\n` +
          'commands: ping | project get | worker scout|request|list|get|read|result|prompt|stop | terminal list|create|read'
      )
  }
}

main().catch((error) => fail(error.message))
