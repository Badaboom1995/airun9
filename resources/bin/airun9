#!/usr/bin/env node
/*
 * airun9 — CLI door to the AIRUN9 public local API (ADR-0008).
 * Speaks newline-delimited JSON-RPC over the app's Unix socket.
 * Injected into the PATH of every managed terminal so agents can call it.
 *
 * Usage:
 *   airun9 ping
 *   airun9 project get                                 # this terminal's project
 *   airun9 project list                                # all open projects + active
 *
 *   # read-only research worker, spawns immediately.
 *   # --wait blocks until it finishes and prints the results (run this as a
 *   # background shell task to stay free — no polling).
 *   airun9 worker scout --prompt "..." [--name x] [--count N] [--wait]
 *
 *   # mutating worker: the USER approves mode + location in the app.
 *   # This call waits for their decision (may take a while; poll
 *   # `worker list` if your call times out — it may still be approved).
 *   # --wait additionally blocks until the work is finished.
 *   airun9 worker request --prompt "..." --recommend bypass|edits|manual \
 *     [--location shared|worktree] [--reason "why this mode"] [--name x] [--count N] [--wait]
 *
 *   # block until workers leave "running", then print them with results
 *   airun9 worker wait <id> [<id>...]
 *
 *   airun9 worker list
 *   airun9 worker read <id> [--tail 20000] [--raw]     # live terminal tail
 *   airun9 worker result <id>                          # final answer (clean text)
 *   airun9 worker prompt <id> --prompt "..."           # follow-up (worker must be done)
 *   airun9 worker stop <id>                            # kill process, keep the tab
 *   airun9 worker close <id>                           # kill process AND remove the tab
 *   airun9 terminal list|create|read
 *   airun9 terminal close <id>                         # close a terminal tab
 *
 *   # embedded browser panes (shared persistent profile — the user's logins).
 *   # The primary agent loop: navigate to the dev server, screenshot, read
 *   # the page text and console, fix, reload.
 *   airun9 browser create [--url <url>] [--position tab|right|down|left|up]
 *   airun9 browser list
 *   airun9 browser navigate <id> --url <url>
 *   airun9 browser back|forward|reload <id>
 *   airun9 browser screenshot <id> --path out.png     # PNG you can read as an image
 *   airun9 browser text <id>                          # rendered page text
 *   airun9 browser console <id> [--tail 20000]        # page console output
 *   airun9 browser close <id>                         # close page AND its tab
 *
 *   airun9 block list                                  # compiled custom blocks
 *   airun9 block open <name> [--position tab|right|down|left|up]
 *   airun9 layout get                                  # the workspace layout tree (JSON)
 *   airun9 layout set --json '<tree>'                  # replace it (or pipe JSON on stdin)
 *
 *   # cross-agent conversation memory (claude, gpt/codex, grok sessions on
 *   # this machine, ingested from their transcript files)
 *   airun9 memory search --query "..." [--agent claude|gpt|grok] [--project] [--limit 20]
 *   airun9 memory sessions [--agent claude|gpt|grok] [--project] [--limit 50]
 *   airun9 memory messages <sessionId> [--limit 200] [--offset 0]
 *   airun9 memory stats
 */
'use strict'

const net = require('net')
const os = require('os')
const path = require('path')

const SOCKET_PATH = process.env.AIRUN9_SOCKET || path.join(os.homedir(), '.airun9', 'airun9.sock')
// Terminals are project-bound: managed terminals carry AIRUN9_PROJECT_ID,
// and every request forwards it so the API acts on THIS terminal's project
// no matter which project the user is currently looking at.
const PROJECT_ID = process.env.AIRUN9_PROJECT_ID || undefined

function fail(message) {
  process.stderr.write(`airun9: ${message}\n`)
  process.exit(1)
}

function parseArgs(argv) {
  const positional = []
  const flags = {}
  for (let i = 0; i < argv.length; i++) {
    const arg = argv[i]
    if (arg.startsWith('--')) {
      const key = arg.slice(2)
      const next = argv[i + 1]
      if (next === undefined || next.startsWith('--')) {
        flags[key] = true
      } else {
        flags[key] = next
        i++
      }
    } else {
      positional.push(arg)
    }
  }
  return { positional, flags }
}

function call(method, params) {
  return new Promise((resolvePromise, rejectPromise) => {
    const socket = net.createConnection(SOCKET_PATH)
    let buffer = ''
    socket.on('connect', () => {
      socket.write(JSON.stringify({ id: 1, method, params, project: PROJECT_ID }) + '\n')
    })
    socket.on('data', (chunk) => {
      buffer += chunk.toString('utf8')
      const newline = buffer.indexOf('\n')
      if (newline === -1) return
      socket.end()
      try {
        const response = JSON.parse(buffer.slice(0, newline))
        if (response.error) rejectPromise(new Error(response.error.message))
        else resolvePromise(response.result)
      } catch (error) {
        rejectPromise(error)
      }
    })
    socket.on('error', (error) => {
      if (error.code === 'ENOENT' || error.code === 'ECONNREFUSED') {
        rejectPromise(new Error(`cannot reach AIRUN9 at ${SOCKET_PATH} — is the app running?`))
      } else {
        rejectPromise(error)
      }
    })
  })
}

function readStdin() {
  return new Promise((resolve) => {
    let data = ''
    process.stdin.on('data', (chunk) => (data += chunk))
    process.stdin.on('end', () => resolve(data))
    process.stdin.on('error', () => resolve(data))
  })
}

// Strip ANSI escape sequences so agents get readable text by default
function stripAnsi(text) {
  return text
    .replace(/\x1b\][^\x07\x1b]*(\x07|\x1b\\)?/g, '') // OSC (title set, hyperlinks)
    .replace(/\x1b\[[0-9;?]*[A-Za-z@^`~]/g, '') // CSI (colors, cursor movement)
    .replace(/\x1b[()#][0-9A-Za-z]/g, '') // charset selection
    .replace(/\x1b[A-Za-z=><]/g, '') // bare escapes
    .replace(/\r\n/g, '\n')
    .replace(/\r/g, '\n')
}

function printResult(result) {
  process.stdout.write(JSON.stringify(result, null, 2) + '\n')
}

function printRead(result, flags) {
  process.stdout.write(flags.raw ? result.data : stripAnsi(result.data))
  if (result.data && !result.data.endsWith('\n')) process.stdout.write('\n')
}

// Claude Code hook endpoint: receives the hook payload on stdin, reports the
// event for the worker identified by AIRUN9_WORKER_ID. Always exits 0 —
// a failing hook must never block the agent.
async function runHook(event) {
  try {
    const workerId = process.env.AIRUN9_WORKER_ID
    if (!workerId) return
    const payload = JSON.parse((await readStdin()) || '{}')
    await call('worker.hookEvent', {
      workerId,
      event,
      transcriptPath: payload.transcript_path || undefined
    })
  } catch {
    // swallow; observability must not break the worker
  }
}

async function main() {
  const { positional, flags } = parseArgs(process.argv.slice(2))
  const [domain, action, id] = positional
  const tail = flags.tail ? Number(flags.tail) : undefined

  if (domain === 'hook') {
    if (action !== 'stop' && action !== 'prompt-submit') fail(`unknown hook event "${action}"`)
    return runHook(action)
  }

  switch (`${domain} ${action}`) {
    case 'ping undefined':
      return printResult(await call('app.ping'))
    case 'project get':
      return printResult(await call('project.get'))
    case 'project list':
      return printResult(await call('project.list'))
    case 'worker scout': {
      if (!flags.prompt || flags.prompt === true) fail('worker scout requires --prompt "..."')
      const params = { prompt: flags.prompt }
      if (typeof flags.name === 'string') params.name = flags.name
      if (flags.count) params.count = Number(flags.count)
      const workers = await call('worker.scout', params)
      if (!flags.wait) return printResult(workers)
      return printResult(await call('worker.wait', { ids: workers.map((w) => w.id) }))
    }
    case 'worker request': {
      if (!flags.prompt || flags.prompt === true) fail('worker request requires --prompt "..."')
      if (typeof flags.recommend !== 'string')
        fail('worker request requires --recommend bypass|edits|manual')
      const params = {
        prompt: flags.prompt,
        recommendedMode: flags.recommend,
        recommendedLocation: typeof flags.location === 'string' ? flags.location : 'shared'
      }
      if (typeof flags.name === 'string') params.name = flags.name
      if (typeof flags.reason === 'string') params.reason = flags.reason
      if (flags.count) params.count = Number(flags.count)
      process.stderr.write('airun9: waiting for the user to approve in AIRUN9…\n')
      const workers = await call('worker.request', params)
      if (!flags.wait) return printResult(workers)
      return printResult(await call('worker.wait', { ids: workers.map((w) => w.id) }))
    }
    case 'worker wait': {
      const ids = positional.slice(2)
      if (ids.length === 0) fail('usage: airun9 worker wait <id> [<id>...]')
      return printResult(await call('worker.wait', { ids }))
    }
    case 'worker list':
      return printResult(await call('worker.list'))
    case 'worker get':
      if (!id) fail('usage: airun9 worker get <id>')
      return printResult(await call('worker.get', { id }))
    case 'worker read':
      if (!id) fail('usage: airun9 worker read <id>')
      return printRead(await call('worker.read', { id, tail }), flags)
    case 'worker result': {
      if (!id) fail('usage: airun9 worker result <id>')
      const result = await call('worker.result', { id })
      if (flags.json) return printResult(result)
      if (result.text === null) {
        return fail(`no result yet (worker status: ${result.status})`)
      }
      process.stdout.write(result.text + '\n')
      return
    }
    case 'worker prompt': {
      if (!id) fail('usage: airun9 worker prompt <id> --prompt "..."')
      if (!flags.prompt || flags.prompt === true) fail('worker prompt requires --prompt "..."')
      return printResult(await call('worker.prompt', { id, prompt: flags.prompt }))
    }
    case 'worker stop':
      if (!id) fail('usage: airun9 worker stop <id>')
      return printResult(await call('worker.stop', { id }))
    case 'worker close':
      if (!id) fail('usage: airun9 worker close <id>')
      return printResult(await call('worker.close', { id }))
    case 'terminal list':
      return printResult(await call('terminal.list'))
    case 'terminal create': {
      const params = {}
      if (typeof flags.cwd === 'string') params.cwd = flags.cwd
      if (typeof flags.title === 'string') params.title = flags.title
      return printResult(await call('terminal.create', params))
    }
    case 'terminal read':
      if (!id) fail('usage: airun9 terminal read <id>')
      return printRead(await call('terminal.read', { id, tail }), flags)
    case 'terminal close':
      if (!id) fail('usage: airun9 terminal close <id>')
      return printResult(await call('terminal.close', { id }))
    case 'browser create': {
      const params = {}
      if (typeof flags.url === 'string') params.url = flags.url
      if (typeof flags.position === 'string') params.position = flags.position
      return printResult(await call('browser.create', params))
    }
    case 'browser list':
      return printResult(await call('browser.list'))
    case 'browser get':
      if (!id) fail('usage: airun9 browser get <id>')
      return printResult(await call('browser.get', { id }))
    case 'browser navigate':
      if (!id || typeof flags.url !== 'string')
        fail('usage: airun9 browser navigate <id> --url <url>')
      return printResult(await call('browser.navigate', { id, url: flags.url }))
    case 'browser back':
      if (!id) fail('usage: airun9 browser back <id>')
      return printResult(await call('browser.back', { id }))
    case 'browser forward':
      if (!id) fail('usage: airun9 browser forward <id>')
      return printResult(await call('browser.forward', { id }))
    case 'browser reload':
      if (!id) fail('usage: airun9 browser reload <id>')
      return printResult(await call('browser.reload', { id }))
    case 'browser screenshot': {
      if (!id) fail('usage: airun9 browser screenshot <id> --path <file.png>')
      const params = { id }
      if (typeof flags.path === 'string') params.path = flags.path
      const shot = await call('browser.screenshot', params)
      // without --path the API returns a data URL; too noisy for a terminal
      return printResult(shot.path ? shot : { width: shot.width, height: shot.height })
    }
    case 'browser text': {
      if (!id) fail('usage: airun9 browser text <id>')
      const page = await call('browser.text', { id })
      process.stdout.write(`${page.title} — ${page.url}\n\n${page.text}\n`)
      if (page.truncated) process.stderr.write('airun9: page text truncated\n')
      return
    }
    case 'browser console':
      if (!id) fail('usage: airun9 browser console <id> [--tail 20000]')
      return printRead(await call('browser.console', { id, tail }), flags)
    case 'browser close':
      if (!id) fail('usage: airun9 browser close <id>')
      return printResult(await call('browser.close', { id }))
    case 'block list':
      return printResult(await call('block.list'))
    case 'block open': {
      if (!id) fail('usage: airun9 block open <name> [--position tab|right|down|left|up]')
      const params = { name: id }
      if (typeof flags.position === 'string') params.position = flags.position
      return printResult(await call('block.open', params))
    }
    case 'layout get':
      return printResult(await call('layout.get'))
    case 'memory search': {
      if (!flags.query || flags.query === true) fail('memory search requires --query "..."')
      const params = { query: flags.query }
      if (typeof flags.agent === 'string') params.agent = flags.agent
      if (typeof flags.cwd === 'string') params.cwd = flags.cwd
      if (flags.project) params.project = true
      if (flags.limit) params.limit = Number(flags.limit)
      return printResult(await call('memory.search', params))
    }
    case 'memory sessions': {
      const params = {}
      if (typeof flags.agent === 'string') params.agent = flags.agent
      if (typeof flags.cwd === 'string') params.cwd = flags.cwd
      if (flags.project) params.project = true
      if (flags.limit) params.limit = Number(flags.limit)
      return printResult(await call('memory.sessions', params))
    }
    case 'memory messages': {
      if (!id) fail('usage: airun9 memory messages <sessionId>')
      const params = { sessionId: id }
      if (flags.limit) params.limit = Number(flags.limit)
      if (flags.offset) params.offset = Number(flags.offset)
      return printResult(await call('memory.messages', params))
    }
    case 'memory stats':
      return printResult(await call('memory.stats'))
    case 'layout set': {
      const raw = typeof flags.json === 'string' ? flags.json : await readStdin()
      if (!raw.trim()) fail('layout set requires --json or JSON on stdin')
      let layout
      try {
        layout = JSON.parse(raw)
      } catch {
        fail('layout set: invalid JSON')
      }
      return printResult(await call('layout.set', { layout }))
    }
    default:
      fail(
        `unknown command "${positional.join(' ')}"\n` +
          'commands: ping | project get | worker scout|request|wait|list|get|read|result|prompt|stop|close | terminal list|create|read|close | browser create|list|get|navigate|back|forward|reload|screenshot|text|console|close | block list|open | layout get|set | memory search|sessions|messages|stats'
      )
  }
}

main().catch((error) => fail(error.message))
